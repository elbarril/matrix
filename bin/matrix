#!/bin/bash

# Matrix CLI — Layer 1 orchestrator (CLI-agnostic)
# Manages registry, projects, the warm-project set, checkpoints, the Link
# ledger, Seraph hooks, and the Trainman build. It NEVER invokes agents.
# Version 2.2.0

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/core.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/link.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/registry.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/binding.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/warm.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/status.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/hooks.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/hardline.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/trainman.sh"


ship_cmd() {
    local subcmd="${1:-}"
    case "$subcmd" in
        list)
            local ship_dir
            for ship_dir in "$BRAIN_DIR/subsystems"/*/; do
                [[ -f "$ship_dir/AGENTS.md" ]] || continue
                local ship_name captain crew
                ship_name="$(sed -n 's/^ship: *//p' "$ship_dir/AGENTS.md" | head -1)"
                [[ -z "$ship_name" ]] && continue
                captain="$(sed -n 's/^captain: *//p' "$ship_dir/AGENTS.md" | head -1)"
                crew="$(sed -n 's/^crew: *//p' "$ship_dir/AGENTS.md" | head -1)"
                echo "  $ship_name — captain: $captain | crew: $crew"
            done
            ;;
        *)
            log_error "Usage: matrix ship list"
            return 1
            ;;
    esac
}

corpus_ingest_cmd() {
    local topic="" slug=""
    local arg
    for arg in "$@"; do
        case "$arg" in
            --topic=*) topic="${arg#*=}" ;;
            --slug=*) slug="${arg#*=}" ;;
            *) log_error "Unknown flag '$arg'"; return 1 ;;
        esac
    done

    [[ -z "$topic" || -z "$slug" ]] && {
        log_error "Usage: matrix corpus-ingest --topic=<topic> --slug=<slug> (content via stdin)"
        return 1
    }

    if [[ ! "$topic" =~ ^[a-z0-9-]+$ ]]; then
        log_error "Invalid topic '$topic': must match [a-z0-9-]+"
        return 1
    fi
    if [[ ! "$slug" =~ ^[a-z0-9-]+$ ]]; then
        log_error "Invalid slug '$slug': must match [a-z0-9-]+"
        return 1
    fi

    local corpus_root="$MATRIX_DIR/brain/subsystems/logos/corpus"
    local sources_dir="$corpus_root/$topic/sources"
    local sources_real target_real

    mkdir -p "$sources_dir" || { log_error "Cannot create $sources_dir"; return 1; }

    sources_real="$(realpath -m "$sources_dir" 2>/dev/null || readlink -f "$sources_dir")"
    local corpus_real="$(realpath -m "$corpus_root" 2>/dev/null || readlink -f "$corpus_root")"
    [[ -n "$sources_real" && -n "$corpus_real" ]] || {
        log_error "Cannot resolve corpus paths"
        return 1
    }

    if [[ "$sources_real" != "$corpus_real"/* ]]; then
        log_error "Destination '$sources_real' is not under '$corpus_real'"
        return 1
    fi

    # Create-only: any <nn>-<slug>.md already present blocks re-ingestion.
    local f
    for f in "$sources_dir"/[0-9][0-9]-"$slug".md; do
        [[ -e "$f" ]] && { log_error "Source '$slug' already exists under corpus/$topic/sources"; return 1; }
    done

    # Pick the next available <nn>.
    local nn=00
    while [[ -e "$sources_dir/$nn-$slug.md" ]]; do
        nn=$(printf '%02d' $((10#$nn + 1)))
        if [[ "$nn" == "100" ]]; then
            log_error "No available <nn> slot under corpus/$topic/sources for slug '$slug'"
            return 1
        fi
    done

    local target="$sources_dir/$nn-$slug.md"

    # Atomic write via temp file + rename.
    local tmp
    tmp="$(mktemp "$sources_dir/.$(basename "$target").XXXXXX")" || {
        log_error "corpus-ingest: cannot create temp file in $sources_dir"
        return 1
    }
    if ! cat > "$tmp"; then
        rm -f "$tmp"
        log_error "corpus-ingest: failed to read stdin"
        return 1
    fi
    if ! mv "$tmp" "$target"; then
        rm -f "$tmp"
        log_error "corpus-ingest: atomic rename failed"
        return 1
    fi
    chmod 644 "$target" || { log_error "corpus-ingest: chmod 644 failed on $target"; return 1; }

    log_success "Ingested corpus/$topic/sources/$nn-$slug.md"
}

show_help() {
    cat << 'EOF'
Matrix CLI — Layer 1 orchestrator (CLI-agnostic)

Usage: matrix <command> [args]

Projects:
  list                    List all registered projects
  add <name> [path] [--replace]  Register a project (path optional → current dir; --replace updates existing)
  remove <name>           Remove a non-warm project from the registry
  select <name> [--target=<cli>]    Warm + set adapter target + output dirs (+ clone if remote); no filesystem binding
  deselect <name>         Clean legacy binding artifacts + remove from the active set
  migrate-nobind [<name>|--all] [--dry-run]  Remove legacy _brain/AGENTS.local.md/exclude artifacts (idempotent)
  bindings [--warm-only]  Show known/warm status for all registered projects (--warm-only for warm set)
  scope                   Print "<mode>\t<project>\t<detail>" for cwd (resolve_scope; used by adapters)
  scope --tree [--json]   Print the memory chain (registered ancestors, innermost first; --json for machines)
  focus <name>            Persist a session-scoped focus (brain/state/sessions/<sid>.json) that
                          resolve_scope_project() prefers over cwd for this session only;
                          requires an active session marker, fails closed on an unregistered project
  adapter-doc-path [<cli>] Print the absolute path to the target adapter's own reference doc (binding.doc_path)

Multi-project (warm set):
  work <name>             Warm a project into the active set
  unwork <name>           Remove a project from the active set
  unwork --all [--dry-run]   Clean legacy artifacts + remove every registered project from the active set (registry untouched)

State & telemetry:
  status [--all]          Show current Matrix status (checkpoints/Link scoped to the
                          resolved chain by default; --all for the unfiltered view)
  checkpoint "<note>"     Write a timestamped checkpoint (+ Link entry)
  activity [n] [--all] [--project=<name>]  Show last n Link ledger events, scoped to
                          the resolved chain by default (default n=20)

Flags:
  flags                   Show the effective feature-flag table (value, source, risk, state, depends_on)
  flags --json            JSON array of all flags
  flags --get <name>      JSON of one flag
  flags --validate        List dangerous/inert flags; exit 1 if any

Link ledger & fleet:
  link <event> <subject> [--ref=<id>] [detail...]  Append a namespaced Link ledger event and echo the ref
  ship list                                         List discovered federated ships
  corpus-ingest --topic=<t> --slug=<s>              Ingest stdin as a new Logos corpus source (sanitized,
                                                   create-only, atomic write)

Hardline:
  hardline dispatch <project> "<line>"  Validate, queue, and acquire the project's dispatch lane
  hardline reject <project> "<line>" "<reason>"
                                         Persist a pre-queue rejection as acked-refused-generic
  hardline status [project]             Show open events, optionally scoped to one project
  hardline resume <event_id>             Trigger recovery (Layer 3 implementation pending)
  hardline queue                         Print the raw persisted queue

Retrospectivas (Devin-specific):
  session-find <cwd> [YYYY-MM-DD]  Busca sesiones pasadas (consulta read-only)
  session-dump <id> [--from HH:MM] [--to HH:MM] [--full]  Reconstruye una sesión pasada (read-only)
  session-cost [cwd] [YYYY-MM-DD]  Muestra duración, ACU y crédito por sesión (read-only)
  session-subagents <id>  Muestra duración de invocaciones de subagentes (read-only)
  session-report [cwd] [YYYY-MM-DD] [--out PATH] [--limit N]  Genera reporte HTML estático
  session close '[<json>]'  Run the session_close hook and persist a session:close entry to the Link ledger

Enforcement & adapters:
  phase close '<json>'    Run the validate_phase_close gate and persist the verdict
                          (PASS or BLOCK) to the Link ledger; exits non-zero on BLOCK
  phase precheck '<json>' Dry-run phase close, then run advisory plan/artifact checks
                          without creating a phase:close ledger entry
  hooks <name> [json]     Run a Seraph hook (pre_activation_check, validate_phase_close,
                          post_run_audit, the_source, validate_layer2, session_start_bootstrap)
  build --target=<cli>    Trainman: generate native artifacts for a CLI (devin)
  install --target=<cli>  Trainman: deploy generated artifacts into the CLI's discovery path
  harden --target=<cli>   Reconcile permissions.deny with secret-deny config (dry-run;
                          use --apply to write, --revert to undo Matrix-managed entries)
  help                    Show this help
EOF
}

scope_cmd() {
    case "${1:-}" in
        --tree) shift; scope_tree "$@" ;;
        -h|--help) echo "Usage: matrix scope [--tree [--json]]"; return 0 ;;
        --*) log_error "Unknown flag '$1'"; return 1 ;;
        *) resolve_scope ;;
    esac
}

flags_cmd() {
    local json=false get="" validate=false arg
    for arg in "$@"; do
        case "$arg" in
            --json) json=true ;;
            --get=*) get="${arg#*=}" ;;
            --get) log_error "--get requires a value"; return 1 ;;
            --validate) validate=true ;;
            --*) log_error "Unknown flag '$arg'"; return 1 ;;
            *) log_error "Unknown argument '$arg'"; return 1 ;;
        esac
    done
    if [[ -n "$get" ]]; then
        python3 "$HOOKS_DIR/_flags.py" get "$get"
        return $?
    fi
    if $validate; then
        python3 "$HOOKS_DIR/_flags.py" validate
        return $?
    fi
    if $json; then
        python3 "$HOOKS_DIR/_flags.py" list
        return $?
    fi
    python3 "$HOOKS_DIR/_flags.py" table
}

main() {
    case "${1:-}" in
        help|--help|-h)
            show_help
            ;;
        "")
            log_error "No command. Use 'matrix help'."
            exit 1
            ;;
        *)
            # Hardline owns dedicated queue/project locks; the global command
            # lock would incorrectly serialize dispatches for different projects.
            [[ "${1:-}" == "hardline" ]] || acquire_lock
            case "${1:-}" in
                list)       list_projects ;;
                add)        shift; add_project "$@" ;;
                remove)     shift; remove_project "$@" ;;
                select)     shift; select_project "$@" ;;
                deselect)   shift; deselect_project "$@" ;;
                migrate-nobind) shift; migrate_nobind_cmd "$@" ;;
                focus)      focus_project "${2:-}" ;;
                work)       work_project "${2:-}" ;;
                unwork)     shift; unwork_dispatch "$@" ;;
                bindings)   shift; show_bindings "$@" ;;
                scope)      shift; scope_cmd "$@" ;;
                flags)      shift; flags_cmd "$@" ;;
                adapter-doc-path) shift; adapter_doc_path "${1:-devin}" ;;
                status)     shift; show_status "$@" ;;
                checkpoint) write_checkpoint "${2:-}" ;;
                activity)   shift; show_activity "$@" ;;
                link)       shift; link_cmd "$@" ;;
                ship)       shift; ship_cmd "${1:-}" "${2:-}" ;;
                corpus-ingest) shift; corpus_ingest_cmd "$@" ;;
                hardline)   shift; hardline_cmd "$@" ;;
                phase)      shift; phase_cmd "$@" ;;
                session)    shift; session_cmd "$@" ;;
                hooks)      shift; run_hook "$@" ;;
                build)      shift; build_target "$@" ;;
                install)    shift; install_target "$@" ;;
                harden)     shift; harden_target "$@" ;;
                session-find) shift; session_query find "$@" ;;
                session-dump) shift; session_query dump "$@" ;;
                session-cost) shift; session_query cost "$@" ;;
                session-subagents) shift; session_query subagents "$@" ;;
                session-report) shift; session_report "$@" ;;
                *)  log_error "Unknown command: $1"; echo "Use 'matrix help'."; exit 1 ;;
            esac
            ;;
    esac
}

command -v jq >/dev/null 2>&1 || { log_error "jq is required but not installed."; exit 1; }
main "$@"
