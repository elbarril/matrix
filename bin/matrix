#!/bin/bash

# Matrix CLI — Layer 1 orchestrator (CLI-agnostic)
# Manages registry, projects, the warm-project set, checkpoints, the Link
# ledger, Seraph hooks, and the Trainman build. It NEVER invokes agents.
# Version 2.1.0

set -euo pipefail

# Colors
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

# --- Robust root resolution (_brain-aware, with traversal fallback) ---------
resolve_root() {
    # 1) If a _brain symlink exists in cwd, the Matrix root is its parent.
    if [[ -L "_brain" ]]; then
        local brain_path; brain_path="$(readlink -f _brain)"
        dirname "$brain_path"; return 0
    fi
    # 2) Walk up from the script location until brain/ + AGENTS.md are found.
    local dir; dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/brain" && -f "$dir/AGENTS.md" ]]; then echo "$dir"; return 0; fi
        dir="$(dirname "$dir")"
    done
    # 3) Last resort: parent of bin/.
    cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd
}

MATRIX_DIR="$(resolve_root)"
REGISTRY_FILE="$MATRIX_DIR/.registry.json"
CONTEXT_FILE="$MATRIX_DIR/.context.yaml"
BRAIN_DIR="$MATRIX_DIR/brain"
STATE_DIR="$BRAIN_DIR/state"
CLIENTS_DIR="$MATRIX_DIR/clients"
WORKSPACE_FILE="$STATE_DIR/workspace.yaml"
ACTIVITY_LOG="$STATE_DIR/activity.log"
CHECKPOINTS_FILE="$STATE_DIR/checkpoints.jsonl"
HOOKS_DIR="$MATRIX_DIR/hooks"

to_abs_path() {
    local p="${1:-}"
    p="${p/#\~/$HOME}"
    [[ -z "$p" || "$p" == "null" ]] && { echo "$p"; return; }
    if [[ "$p" == /* ]]; then
        echo "${p%/}"
    else
        echo "${MATRIX_DIR}/${p#./}" | sed 's#//*#/#g'
    fi
}

log_info()    { echo -e "${BLUE}[MATRIX]${NC} $1"; }
log_success() { echo -e "${GREEN}[MATRIX]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[MATRIX]${NC} $1"; }
log_error()   { echo -e "${RED}[MATRIX]${NC} $1"; }

# --- Global lock ------------------------------------------------------------
acquire_lock() {
    if ! command -v flock >/dev/null 2>&1; then
        log_warning "flock not available; running without global lock"
        return 0
    fi
    mkdir -p "$STATE_DIR"
    exec 200>"$STATE_DIR/.matrix.lock"
    flock -x -w 30 200 || { log_error "Could not acquire global lock (timeout?)"; exit 1; }
}
release_lock() {
    if command -v flock >/dev/null 2>&1; then
        exec 200>&- 2>/dev/null || true
    fi
}

# --- Init -------------------------------------------------------------------
init_registry() {
    [[ -f "$REGISTRY_FILE" ]] || echo '{"projects": [], "created": "'$(date -Iseconds)'", "version": "2.0.0"}' > "$REGISTRY_FILE"
}
init_context() {
    [[ -f "$CONTEXT_FILE" ]] || cat > "$CONTEXT_FILE" << 'EOF'
# Matrix Active Project Context (primary binding)
active_project: null
active_project_path: null
last_updated: null
session_id: null
EOF
}
init_state() {
    mkdir -p "$STATE_DIR/sessions"
    [[ -f "$ACTIVITY_LOG" ]] || : > "$ACTIVITY_LOG"
    [[ -f "$CHECKPOINTS_FILE" ]] || : > "$CHECKPOINTS_FILE"
    [[ -f "$WORKSPACE_FILE" ]] || cat > "$WORKSPACE_FILE" << 'EOF'
# Matrix Workspace State — the SET of warm projects (multi-project)
active_projects: []
last_updated: null
system_status: "initialized"
EOF
}

# --- Link ledger ------------------------------------------------------------
# Append an event: link_append <event> <subject> <detail...>
link_append() {
    init_state
    local event="$1"; shift
    local subject="${1:-matrix}"; shift || true
    local detail="$*"
    printf '%s | %-12s | %-16s | %s\n' "$(date -Iseconds)" "$event" "$subject" "$detail" >> "$ACTIVITY_LOG"
}

read_registry() { init_registry; jq -r '.projects[] | "\(.name):\(.path):\(.type)"' "$REGISTRY_FILE" 2>/dev/null || echo ""; }
read_context()  { init_context; sed -n 's/^active_project: //p' "$CONTEXT_FILE" | head -1 || echo "null"; }

update_context() {
    init_context
    local project="$1" path="$2"; path="${path%/}"
    sed -i "s|^active_project:.*|active_project: $project|" "$CONTEXT_FILE"
    sed -i "s|^active_project_path:.*|active_project_path: $path|" "$CONTEXT_FILE"
    sed -i "s|^last_updated:.*|last_updated: $(date -Iseconds)|" "$CONTEXT_FILE"
}

# --- Project registry -------------------------------------------------------
add_project() {
    local name="$1" path_or_url="${2:-}"
    [[ -z "$name" ]] && { log_error "Usage: matrix add <name> [path-or-url]"; return 1; }
    if [[ -z "$path_or_url" ]]; then
        local current_dir; current_dir="$(pwd)"
        log_info "No path provided. Current directory: $current_dir"
        echo -n "Use this path? [y/N]: "; read -r r
        [[ "$r" =~ ^[Yy]$ ]] || { log_warning "Cancelled"; return 1; }
        path_or_url="$current_dir"
    fi
    local existing; existing="$(registry_path "$name")"
    [[ -n "$existing" && "$existing" != "null" ]] && { log_error "Project '$name' already exists"; return 1; }
    local type="local"
    [[ "$path_or_url" =~ ^https?:// || "$path_or_url" =~ ^git@ ]] && type="remote"
    [[ "$type" == "local" ]] && path_or_url="${path_or_url%/}"
    local tmp; tmp="$(mktemp)"
    jq --arg n "$name" --arg p "$path_or_url" --arg t "$type" \
       '.projects += [{"name": $n, "path": $p, "type": $t, "added": "'$(date -Iseconds)'"}]' \
       "$REGISTRY_FILE" > "$tmp" && mv "$tmp" "$REGISTRY_FILE"
    link_append "project:add" "$name" "$path_or_url"
    log_success "Added project '$name'"
}

list_projects() {
    log_info "Known projects:"; echo
    init_registry
    local projects; projects="$(jq -r '.projects[] | "\(.name)\t\(.path)\t\(.type)"' "$REGISTRY_FILE" 2>/dev/null)"
    [[ -z "$projects" ]] && { echo "  No projects registered"; return; }
    local active; active="$(read_context)"
    while IFS=$'\t' read -r name path type; do
        local marks=""
        [[ "$active" == "$name" ]] && marks+="[primary] "
        is_bound "$name" && marks+="[bound]"
        if [[ -n "$marks" ]]; then
            echo "  ✓ $name ($type) - $path $marks"
        else
            echo "    $name ($type) - $path"
        fi
    done <<< "$projects"
}

registry_path() {
    local name="$1"
    init_registry
    jq -r --arg n "$name" '.projects[] | select(.name==$n) | .path' "$REGISTRY_FILE" 2>/dev/null
}

registry_type() {
    local name="$1"
    init_registry
    jq -r --arg n "$name" '.projects[] | select(.name==$n) | .type' "$REGISTRY_FILE" 2>/dev/null
}

get_project_path() {
    local name="$1"
    local p t
    p="$(registry_path "$name")"
    t="$(registry_type "$name")"
    [[ -z "$p" || "$p" == "null" ]] && return 1
    if [[ "$t" == "remote" ]]; then
        echo "$CLIENTS_DIR/$name"
    else
        p="$(to_abs_path "$p")"
        echo "${p%/}"
    fi
}

resolve_project_path() {
    local name="$1"
    get_project_path "$name"
}

is_bound() {
    local name="$1"
    local pp; pp="$(get_project_path "$name" 2>/dev/null)" || return 1
    [[ -z "$pp" ]] && return 1
    local link="$pp/_brain"
    [[ -L "$link" ]] || return 1
    local rl; rl="$(readlink -f "$link" 2>/dev/null || true)"
    [[ "$rl" == "$BRAIN_DIR" ]] || return 1
    [[ -f "$pp/AGENTS.local.md" ]] || return 1
    grep -q '^<!-- MATRIX:BEGIN' "$pp/AGENTS.local.md" && grep -q '^<!-- MATRIX:END -->$' "$pp/AGENTS.local.md"
}

# --- AGENTS.local.md binding (non-probabilistic Neo activation) -----------
matrix_block_tmp() {
    local tmp; tmp="$(mktemp)"
    cat > "$tmp" <<EOF
<!-- MATRIX:BEGIN (managed by \`bin/matrix select\` — do not hand-edit this block) -->
# Matrix — mandatory first action

This project is bound to the Matrix system (root: $MATRIX_DIR). Before responding
to ANY request in this project — regardless of topic, even if it looks completely
unrelated to Matrix, even if another skill also matches — read in full, in order:

1. $MATRIX_DIR/AGENTS.md         (the Matrix contract — sacred foundation, roster, routing doctrine)
2. $BRAIN_DIR/agents/neo.md  (the Neo master agent; run its \`<activation>\` block starting at step 0)

Only after both reads may Neo decide this request doesn't need Matrix and step back.
This block is regenerated by \`bin/matrix select\` / removed by \`bin/matrix deselect\` — do not edit it by hand; edit outside the markers instead.
<!-- MATRIX:END -->
EOF
    echo "$tmp"
}

update_agents_local() {
    local pp="$1"
    local file="$pp/AGENTS.local.md"
    local block; block="$(matrix_block_tmp)"

    if [[ -f "$file" ]]; then
        if grep -q '^<!-- MATRIX:BEGIN' "$file" && grep -q '^<!-- MATRIX:END -->$' "$file"; then
            awk -v new="$block" '
                /^<!-- MATRIX:BEGIN/ {
                    while ((getline line < new) > 0) print line
                    close(new)
                    inside=1
                    next
                }
                /^<!-- MATRIX:END -->$/ { inside=0; next }
                !inside { print }
            ' "$file" > "$file.new" && mv "$file.new" "$file"
            log_success "Updated AGENTS.local.md"
        else
            { echo ""; cat "$block"; } >> "$file"
            log_success "Appended Matrix block to AGENTS.local.md"
        fi
    else
        mv "$block" "$file"
        log_success "Wrote AGENTS.local.md"
    fi
    rm -f "$block"
}

cleanup_agents_local() {
    local ap="$1"
    local file="$ap/AGENTS.local.md"
    [[ -f "$file" ]] || return 0

    if grep -q '^<!-- MATRIX:BEGIN' "$file" && grep -q '^<!-- MATRIX:END -->$' "$file"; then
        awk '
            /^<!-- MATRIX:BEGIN/ { inside=1; next }
            /^<!-- MATRIX:END -->$/ { inside=0; next }
            !inside { print }
        ' "$file" > "$file.new"

        if grep -q '[^[:space:]]' "$file.new"; then
            mv "$file.new" "$file"
            log_success "Removed Matrix block from AGENTS.local.md"
        else
            rm -f "$file.new" "$file"
            log_success "Removed AGENTS.local.md (empty after cleanup)"
        fi
    else
        log_warning "AGENTS.local.md has no Matrix block; leaving untouched"
    fi
}

update_gitignore() {
    local pp="$1"
    [[ -d "$pp/.git" ]] || return 0
    if [[ -f "$pp/.gitignore" ]]; then
        if grep -qxF "AGENTS.local.md" "$pp/.gitignore" 2>/dev/null; then return 0; fi
        printf 'AGENTS.local.md\n' >> "$pp/.gitignore"
        log_success "Added AGENTS.local.md to .gitignore"
    else
        printf 'AGENTS.local.md\n' > "$pp/.gitignore"
        log_success "Created .gitignore with AGENTS.local.md"
    fi
}

select_project() {
    local name="$1"
    [[ -z "$name" ]] && { log_error "Usage: matrix select <name>"; return 1; }
    local p t pp
    p="$(registry_path "$name")"
    t="$(registry_type "$name")"
    [[ -z "$p" || "$p" == "null" ]] && { log_error "Project '$name' not found"; return 1; }
    if [[ "$t" == "remote" ]]; then
        pp="$CLIENTS_DIR/$name"
        [[ -d "$pp" ]] || { log_info "Cloning '$name'..."; mkdir -p "$CLIENTS_DIR"; git clone "$p" "$pp"; }
    else
        pp="$(to_abs_path "$p")"; pp="${pp%/}"
    fi
    # Validate the new project's path BEFORE touching the currently active
    # one — a failed select must never leave the session without an active
    # project it already had.
    [[ -d "$pp" ]] || { log_error "Path '$pp' does not exist"; return 1; }
    local link="$pp/_brain"
    if [[ -L "$link" ]]; then
        local current; current="$(readlink -f "$link" 2>/dev/null || true)"
        if [[ "$current" != "$BRAIN_DIR" ]]; then
            rm "$link"
        fi
    fi
    [[ -e "$link" && ! -L "$link" ]] && { log_error "'_brain' exists and is not a symlink"; return 1; }
    [[ -L "$link" ]] || ln -sf "$BRAIN_DIR" "$link"
    update_agents_local "$pp"
    update_gitignore "$pp"
    update_context "$name" "$pp"
    # Invariant: the primary project is always a member of the warm set —
    # otherwise workspace.yaml silently drifts from what's actually being
    # worked on (the bug this fixes: `select` never touched it, so it kept
    # reflecting whatever was last `work`ed, sometimes weeks stale).
    warm_project_entry "$name" "$pp" "quiet"
    link_append "project:select" "$name" "$pp"
    log_success "Selected primary project '$name' (symlink: $link)"
}

deselect_project() {
    local name="${1:-}"
    local active; active="$(read_context)"
    if [[ -z "$name" ]]; then
        [[ "$active" == "null" || -z "$active" ]] && { log_warning "No active project"; return 0; }
        name="$active"
    fi
    local ap; ap="$(get_project_path "$name" 2>/dev/null)" || { log_warning "Project '$name' not found"; return 0; }
    if ! is_bound "$name"; then
        log_warning "Project '$name' is not bound"
        return 0
    fi
    cleanup_agents_local "$ap"
    [[ -n "$ap" && -L "$ap/_brain" ]] && rm "$ap/_brain"
    if [[ "$active" == "$name" ]]; then
        update_context "null" "null"
    fi
    link_append "project:deselect" "$name" ""
    log_success "Deselected '$name'"
}

# --- Multi-project warm set -------------------------------------------------
# warm_project_entry <name> <path> [quiet]
# Shared, idempotent core: ensures <name> is a member of the warm set with
# the given (already-resolved) path. Used by both `matrix work` (resolves
# the path itself from the registry) and `select_project` (already has the
# resolved path, including the local clone dir for `remote` projects — never
# re-resolve from the registry there, or a `remote` project's warm entry
# would end up holding the remote URL instead of its local checkout path).
warm_project_entry() {
    local name="$1" path="$2" quiet="${3:-}"
    init_state
    if grep -qxF "  - name: $name" "$WORKSPACE_FILE" 2>/dev/null; then
        [[ "$quiet" == "quiet" ]] || log_warning "'$name' already warm"
        return 0
    fi
    # Insert before the last_updated line.
    local ts; ts="$(date -Iseconds)"
    local tmp; tmp="$(mktemp)"
    awk -v n="$name" -v p="$path" -v ts="$ts" '
        /^active_projects:/ && $0 ~ /\[\]/ { print "active_projects:"; print "  - name: " n; print "    path: " p; print "    activated: " ts; next }
        /^last_updated:/ { print "last_updated: \"" ts "\""; next }
        { print }
    ' "$WORKSPACE_FILE" > "$tmp"
    # If the set was non-empty, the awk above only handles the empty case; handle non-empty by append.
    if grep -qxF "  - name: $name" "$tmp"; then mv "$tmp" "$WORKSPACE_FILE"; else
        rm -f "$tmp"
        # Append under active_projects: (non-empty list)
        sed -i "/^active_projects:/a\\  - name: $name\\n    path: $path\\n    activated: $ts" "$WORKSPACE_FILE"
        sed -i "s|^last_updated:.*|last_updated: \"$ts\"|" "$WORKSPACE_FILE"
    fi
    link_append "project:work" "$name" "$path"
    [[ "$quiet" == "quiet" ]] || log_success "Warmed '$name' into the active set"
}

work_project() {
    local name="$1"
    [[ -z "$name" ]] && { log_error "Usage: matrix work <name>"; return 1; }
    local path; path="$(resolve_project_path "$name")" || { log_error "Project '$name' not found"; return 1; }
    warm_project_entry "$name" "$path"
}

unwork_project() {
    local name="$1"
    [[ -z "$name" ]] && { log_error "Usage: matrix unwork <name>"; return 1; }
    init_state
    if is_bound "$name"; then
        deselect_project "$name"
    fi
    # Remove the 3-line block for this project (literal match, no regex).
    local tmp; tmp="$(mktemp)"
    NAME="$name" awk '
        BEGIN { line = "  - name: " ENVIRON["NAME"] }
        $0 == line { skip=2; next }
        skip > 0 { skip--; next }
        { print }
    ' "$WORKSPACE_FILE" > "$tmp" && mv "$tmp" "$WORKSPACE_FILE"
    # If list is now empty, normalize.
    grep -q "^  - name:" "$WORKSPACE_FILE" || sed -i "s|^active_projects:.*|active_projects: []|" "$WORKSPACE_FILE"
    sed -i "s|^last_updated:.*|last_updated: \"$(date -Iseconds)\"|" "$WORKSPACE_FILE"
    link_append "project:unwork" "$name" ""
    log_success "Removed '$name' from the active set"
}

show_workspace() {
    init_state
    log_info "Warm project set:"; echo
    local names; names="$(grep "^  - name:" "$WORKSPACE_FILE" 2>/dev/null | sed 's/  - name: //' || true)"
    if [[ -z "$names" ]]; then
        echo "   (empty) — use 'matrix work <name>'"
        return
    fi
    while IFS= read -r n; do
        [[ -z "$n" ]] && continue
        local mark=""
        is_bound "$n" && mark=" [bound]"
        echo "   • $n$mark"
    done <<< "$names"
}

# --- Status -----------------------------------------------------------------
show_bindings() {
    log_info "Bound projects:"; echo
    local projects; projects="$(jq -r '.projects[] | "\(.name)\t\(.path)\t\(.type)"' "$REGISTRY_FILE" 2>/dev/null)"
    [[ -z "$projects" ]] && { echo "  (none registered)"; return; }
    while IFS=$'\t' read -r name path type; do
        local real_path; real_path="$(get_project_path "$name" 2>/dev/null || true)"
        if is_bound "$name"; then
            echo "  ✓ $name -> $real_path [bound]"
        else
            echo "  ✗ $name -> $real_path"
        fi
    done <<< "$projects"
}

show_status() {
    log_info "Matrix Status"; echo
    local active; active="$(read_context)"
    if [[ "$active" != "null" && -n "$active" ]]; then
        local ap; ap="$(get_project_path "$active" 2>/dev/null || true)"; ap="${ap%/}"
        echo "Primary project: $active"
        [[ -n "$ap" ]] && echo "Path: $ap"
        if [[ -n "$ap" && -L "$ap/_brain" ]]; then echo "Brain link: ✓ active"; else echo "Brain link: ✗ broken"; fi
    else
        echo "Primary project: none"
    fi
    echo
    local bound_count=0 bound_names=""
    while IFS=: read -r n _ _; do
        [[ -z "$n" ]] && continue
        if is_bound "$n"; then
            bound_count=$((bound_count+1))
            bound_names="$bound_names$n "
        fi
    done <<< "$(read_registry)"
    bound_names="${bound_names% }"
    echo "Bound: $bound_count project(s)${bound_names:+ ($bound_names)}"
    local warm_n; warm_n="$(grep -c '^  - name:' "$WORKSPACE_FILE" 2>/dev/null)" || warm_n=0
    echo "Warm set: ${warm_n:-0} project(s)"
    local reg_n; reg_n="$(jq '.projects | length' "$REGISTRY_FILE" 2>/dev/null)" || reg_n=0
    echo "Registered: ${reg_n:-0} project(s)"
    echo
    if [[ -s "$CHECKPOINTS_FILE" ]]; then
        echo "Recent checkpoints:"
        tail -n 3 "$CHECKPOINTS_FILE" | jq -r '"  " + .timestamp + " — " + .note' 2>/dev/null || true
    fi
    echo
    if [[ -s "$ACTIVITY_LOG" ]]; then
        echo "Recent Link events:"
        tail -n 3 "$ACTIVITY_LOG" | sed 's/^/  /'
    fi
}

# --- Checkpoints ------------------------------------------------------------
write_checkpoint() {
    local note="$1"
    [[ -z "$note" ]] && { log_error "Usage: matrix checkpoint \"<note>\""; return 1; }
    init_state
    local ts; ts="$(date -Iseconds)"
    local active; active="$(read_context)"
    jq -n -c --arg ts "$ts" --arg user "Emiliano" --arg proj "$active" --arg note "$note" \
        '{timestamp:$ts,user:$user,project:$proj,note:$note,context:{active_agents:[],current_focus:"",blockers:[],next_actions:[]}}' \
        >> "$CHECKPOINTS_FILE"
    link_append "checkpoint" "$active" "$note"
    log_success "Checkpoint written"
}

show_activity() {
    init_state
    local n="${1:-20}"
    log_info "Link ledger (last $n):"; echo
    tail -n "$n" "$ACTIVITY_LOG" | sed 's/^/  /'
}

# --- Seraph hooks -----------------------------------------------------------
run_hook() {
    local name="$1"; shift || true
    local hook="$HOOKS_DIR/$name.py"
    [[ -f "$hook" ]] || { log_error "Hook '$name' not found at $hook"; return 1; }
    MATRIX_ROOT="$MATRIX_DIR" python3 "$hook" "$@"
}

# --- Trainman build ---------------------------------------------------------
build_target() {
    local target=""
    for arg in "$@"; do case "$arg" in --target=*) target="${arg#*=}";; esac; done
    [[ -z "$target" ]] && { log_error "Usage: matrix build --target=<cli>"; return 1; }
    local builder="$MATRIX_DIR/adapters/$target/build.sh"
    if [[ -x "$builder" ]]; then
        log_info "Trainman: building artifacts for '$target'..."
        MATRIX_ROOT="$MATRIX_DIR" "$builder"
        link_append "build" "$target" "artifacts generated"
    else
        log_warning "Trainman: no adapter builder at $builder (not implemented yet for '$target')."
        return 1
    fi
}

# --- Trainman install (deploy artifacts into the host CLI's discovery path) --
install_target() {
    local target=""
    for arg in "$@"; do case "$arg" in --target=*) target="${arg#*=}";; esac; done
    [[ -z "$target" ]] && { log_error "Usage: matrix install --target=<cli>"; return 1; }
    local installer="$MATRIX_DIR/adapters/$target/install.sh"
    if [[ -x "$installer" ]]; then
        log_info "Trainman: installing artifacts for '$target' into the discovery path..."
        MATRIX_ROOT="$MATRIX_DIR" "$installer"
        link_append "install" "$target" "artifacts deployed"
    else
        log_warning "Trainman: no adapter installer at $installer (not implemented yet for '$target')."
        return 1
    fi
}

show_help() {
    cat << 'EOF'
Matrix CLI — Layer 1 orchestrator (CLI-agnostic)

Usage: matrix <command> [args]

Projects:
  list                    List all registered projects
  add <name> [path]       Register a project (path optional → current dir)
  select <name>           Set primary active project + create _brain symlink
  deselect [name]         Remove binding for a project (defaults to primary)
  bindings                Show bound status for all registered projects

Multi-project (warm set):
  work <name>             Warm a project into the active set
  unwork <name>           Remove a project from the active set
  workspace               Show the warm project set

State & telemetry:
  status                  Show current Matrix status
  checkpoint "<note>"     Write a timestamped checkpoint (+ Link entry)
  activity [n]            Show last n Link ledger events (default 20)

Enforcement & adapters:
  hooks <name> [json]     Run a Seraph hook (pre_activation_check, validate_phase_close,
                          post_run_audit, the_source)
  build --target=<cli>    Trainman: generate native artifacts for a CLI (devin)
  install --target=<cli>  Trainman: deploy generated artifacts into the CLI's discovery path
  help                    Show this help
EOF
}

main() {
    acquire_lock
    case "${1:-}" in
        list)       list_projects ;;
        add)        add_project "${2:-}" "${3:-}" ;;
        select)     select_project "${2:-}" ;;
        deselect)   deselect_project "${2:-}" ;;
        work)       work_project "${2:-}" ;;
        unwork)     unwork_project "${2:-}" ;;
        workspace)  show_workspace ;;
        bindings)   show_bindings ;;
        status)     show_status ;;
        checkpoint) write_checkpoint "${2:-}" ;;
        activity)   show_activity "${2:-}" ;;
        hooks)      shift; run_hook "$@" ;;
        build)      shift; build_target "$@" ;;
        install)    shift; install_target "$@" ;;
        help|--help|-h) show_help ;;
        "") log_error "No command. Use 'matrix help'."; exit 1 ;;
        *)  log_error "Unknown command: $1"; echo "Use 'matrix help'."; exit 1 ;;
    esac
}

command -v jq >/dev/null 2>&1 || { log_error "jq is required but not installed."; exit 1; }
main "$@"
