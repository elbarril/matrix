# Matrix Intelligence Engine - Git Ignore

# Project repos (pulled on demand)
clients/

# Brain symlink (created in active projects)
_brain

# Runtime state (Layer 1) — per-machine, changes every session, never committed.
# Managed exclusively by bin/matrix; agents never hand-edit these.
brain/state/*
!brain/state/.gitkeep

# Work artifacts produced in Matrix-workspace-mode (working on Matrix itself).
# Project-bound work artifacts live in the PROJECT's own `matrix-output/`
# directory (sibling to its `_brain` symlink), never here — see
# brain/workflows/spec.md.
brain/output/*
!brain/output/.gitkeep

# Sensitive / per-machine config
brain/config.yaml
.context.yaml

# Generated adapter artifacts (Trainman build output)
adapters/*/generated/

# The Hardline event inbox (per-machine, may carry transient data)
modules/hardline/inbox.log

# Federated ship corpora (per-machine)
brain/subsystems/*/corpus/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

*.backup
# Python cache
__pycache__/
*.pyc
