# Matrix — variables y aliases portátiles (EJEMPLO / plantilla de referencia).
#
# Esto es SOLO una plantilla: el instalador NO modifica tu ~/.bash_aliases.
# Copiá lo que necesites al final de tu ~/.bash_aliases (o a otro archivo que
# sourcees en tu shell) y adaptalo a tu cuenta.
#
# ADVERTENCIA: si ya tenés un ~/.bash_aliases con templatesTools, NO lo pises;
# agregá lo de Matrix al final.

# Raíz del repo Matrix. Si no está seteada, cae a la carpeta donde vive este
# archivo (asumido como la raíz del repo).
if [[ -z "${MATRIX_ROOT:-}" ]]; then
    MATRIX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
fi
export MATRIX_ROOT

# Alias principal de Matrix.
alias matrix='$MATRIX_ROOT/bin/matrix'

# Alias del dashboard Hardline (webapp + browser).
# Requiere xdg-open en Linux; en macOS usá 'open' (adaptalo).
alias hardlines='$MATRIX_ROOT/modules/hardline/hardline-ctl.sh webapp-start >/dev/null 2>&1; xdg-open "http://127.0.0.1:${MATRIX_HARDLINE_WEBAPP_PORT:-8765}/" >/dev/null 2>&1 &'

# --- Configuración específica de TU cuenta -----------------------------------
# REEMPLAZÁ con tus valores. NUNCA commitees ni pegues tokens reales acá.
# export <TU_VARIABLE>='...'        # ej. token de acceso a tu repo/git
# export <TU_OTRA_VARIABLE>='...'   # ej. puerto o ruta específica de tu cuenta
